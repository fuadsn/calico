<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calico_bg">

    <android.opengl.GLSurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Header, like the workout screen: large title, exercise below, light pill on the right.
         Padding is applied in code so it clears the display cutout. -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/preview_header_scrim"
        android:gravity="top"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:textColor="#FFFFFF"
                android:textSize="28sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/preview_subtitle"
                android:textColor="#D9FFFFFF"
                android:textSize="17sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/credits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/preview_snow_pill"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:text="@string/model_credits"
            android:textColor="@color/calico_charcoal"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Sits on the top edge of the rounded demo card; positioned in code. -->
    <TextView
        android:id="@+id/insetLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/preview_snow_pill"
        android:elevation="2dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:text="@string/preview_demo_label"
        android:textAllCaps="true"
        android:textColor="@color/calico_charcoal"
        android:textSize="12sp"
        android:visibility="invisible" />

    <!-- Transparent tap target over the GL-drawn demo card; sized and placed in code.
         It swallows the tap, so opening the demo never moves the AR figure. -->
    <View
        android:id="@+id/demoHitArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="top|start"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/preview_demo_label"
        android:visibility="invisible" />

    <!-- Bottom sheet, like the workout screen: Card surface, rounded top, handle, then actions. -->
    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/preview_sheet"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/preview_handle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:text="@string/preview_sheet_label"
            android:textAllCaps="true"
            android:textColor="@color/calico_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:minLines="2"
            android:text="@string/preview_looking"
            android:textColor="@color/calico_ink"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/back"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/preview_circle_button"
                android:contentDescription="@string/preview_back"
                android:src="@drawable/ic_preview_back" />

            <Button
                android:id="@+id/start"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/preview_accent_pill"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="@string/preview_start"
                android:textAllCaps="false"
                android:textColor="@color/calico_on_accent"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
