<resources>
    <style name="CalicoPrimaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/calico_primary_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">#D9F56B</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="CalicoSecondaryButton" parent="CalicoPrimaryButton">
        <item name="android:background">@drawable/calico_secondary_button</item>
        <item name="android:textColor">#1E1E2E</item>
    </style>
</resources>
